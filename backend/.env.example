# Docker (внутри контейнера medusa):
# DATABASE_URL=postgres://postgres:postgres@postgres:5432/medusa
# REDIS_URL=redis://redis:6379
# Локальная разработка (postgres/redis в Docker, medusa на хосте):
DATABASE_URL=postgres://postgres:postgres@localhost:5432/medusa
REDIS_URL=redis://localhost:6379

JWT_SECRET=supersecret
COOKIE_SECRET=supersecret

PORT=9000
STORE_CORS=http://localhost:3000,http://localhost:8000
ADMIN_CORS=http://localhost:3000,http://localhost:7001

STAFF_JWT_SECRET=supersecret

OWNER_EMAIL=admin@example.com
OWNER_PASSWORD=12345Q